# LegalMetrix AI Environment Configuration
PROJECT_NAME="LegalMetrix AI"
ENVIRONMENT=development
API_V1_STR=/api
SECRET_KEY=legalmetrix-ai-super-secret-key-regulation-compliance-2026
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (SQLite by default, PostgreSQL ready)
DATABASE_URL=sqlite:///./legalmetrix.db
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/legalmetrix_ai

# OCR Configuration
PRIMARY_OCR_ENGINE=winocr
FALLBACK_OCR_ENGINE=paddleocr
TESSERACT_CMD=
ENABLE_PREPROCESSING=true

# Storage
UPLOAD_DIR=./uploads
REPORTS_DIR=./generated_reports
MAX_UPLOAD_SIZE_MB=25

